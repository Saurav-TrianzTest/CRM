# AWS Cloud Configuration Template
# Copy this file to .env and populate with actual values for local development
# In production, use AWS Systems Manager Parameter Store or Secrets Manager

# Database Configuration
DB_URL=jdbc:mysql://your-rds-endpoint.amazonaws.com:3306/crm?useSSL=true
DB_USERNAME=crmuser
DB_PASSWORD=<get-from-secrets-manager>
DB_DDL_AUTO=validate
DB_POOL_SIZE=20
DB_POOL_MIN_IDLE=5
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<for-local-dev-only>
AWS_SECRET_ACCESS_KEY=<for-local-dev-only>

# S3 Storage Configuration
PDF_STORAGE_BUCKET=crm-pdf-storage-bucket
PDF_STORAGE_ENABLED=true
CSV_S3_BUCKET=crm-csv-data-bucket

# CSV File Configuration
CSV_SOURCE=s3
CSV_FILE_PATH=data/sample.csv
CSV_S3_KEY=uploads/data.csv

# Server Configuration
PORT=8080
SERVER_PORT=8080

# Management Security
MANAGEMENT_SECURITY_ENABLED=true

# Thymeleaf Configuration
THYMELEAF_CACHE=true

# Spring Profile
SPRING_PROFILES_ACTIVE=production
